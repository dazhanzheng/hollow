      }
    },
    "Quick hash (sampled) is always computed at intake. Full hash reads the entire file and is useful for 100% accurate duplicate detection." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "快速哈希（采样）始终在摄取时计算。完整哈希会读取整个文件，可用于100%准确的重复检测。" }
        }
      }
    },
